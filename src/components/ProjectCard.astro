---
import type { Project } from "@/data/projects";
import LinkButton from "./LinkButton.astro";
import IconGitHub from "@/assets/icons/IconGitHub.svg";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";

type Props = Project;

const { title, description, highlights, tech, github, live, featured } =
  Astro.props;
---

<li
  class:list={[
    "my-8 rounded-lg border border-border p-6",
    { "border-accent/40": featured },
  ]}
>
  <div class="flex flex-wrap items-start justify-between gap-2">
    <h2 class="text-xl font-semibold text-accent sm:text-2xl">{title}</h2>
    {
      featured && (
        <span class="rounded border border-accent/50 px-2 py-0.5 text-xs font-medium text-accent">
          Featured
        </span>
      )
    }
  </div>

  <p class="mt-3">{description}</p>

  <ul class="mt-4 list-disc space-y-1 ps-5">
    {highlights.map(highlight => <li>{highlight}</li>)}
  </ul>

  <ul class="mt-4 flex flex-wrap gap-2">
    {
      tech.map(item => (
        <li>
          <span class="rounded border border-border px-2 py-0.5 text-sm">
            {item}
          </span>
        </li>
      ))
    }
  </ul>

  {
    (github || live) && (
      <div class="mt-5 flex flex-wrap gap-4">
        {github && (
          <LinkButton
            href={github}
            target="_blank"
            rel="noopener noreferrer"
            class="underline decoration-dashed underline-offset-4"
          >
            <IconGitHub class="inline-block size-5" />
            GitHub
          </LinkButton>
        )}
        {live && (
          <LinkButton
            href={live}
            target="_blank"
            rel="noopener noreferrer"
            class="underline decoration-dashed underline-offset-4"
          >
            Live Demo
            <IconArrowRight class="inline-block rtl:-rotate-180" />
          </LinkButton>
        )}
      </div>
    )
  }
</li>
